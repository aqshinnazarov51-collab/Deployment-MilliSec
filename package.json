{
  "name": "lumio-learning-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate && prisma migrate dev",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint app actions components lib prisma --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma migrate dev",
    "catalog:refresh": "tsx prisma/refresh-catalog.ts",
    "db:update-demo-videos": "tsx prisma/update-demo-videos.ts",
    "db:update-demo-content": "tsx prisma/update-demo-content.ts",
    "db:add-demo-courses": "tsx prisma/add-demo-courses.ts",
    "seed": "npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.18",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "^8.57.0",
    "prisma": "^6.8.2",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    },
    "deepmerge-ts": "8.0.0",
    "source-map-js": "1.2.2"
  }
}
