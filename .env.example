DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Demo seeding deletes and recreates demo records. Keep disabled unless intentionally seeding a local database.
ALLOW_DEMO_SEED="false"
# Required only when ALLOW_DEMO_SEED=true. Set unique local-only passphrases of at least 15 characters.
SEED_STUDENT_PASSWORD=""
SEED_INSTRUCTOR_PASSWORD=""
SEED_ADMIN_PASSWORD=""
# Local development. On EC2 production defaults to /var/lib/lumio/uploads (root EBS).
# Set UPLOAD_DIR to an EBS/EFS mount path if the app instance can be replaced.
UPLOAD_DIR="./public/uploads"
# Local development URL. On AWS, set APP_URL to https://lumiocourse.site.
APP_URL="http://localhost:3000"
# Optional for production password-reset emails (Resend):
RESEND_API_KEY=""
EMAIL_FROM="Lumio <no-reply@example.com>"
